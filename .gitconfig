[alias]
    aa = add --all
    ap = add --patch
    br = branch -a
    ci = commit
    cl = clean -f
    co = checkout
    d = diff
    dc = diff --cached
    f = fetch --prune
    pl = pull
    ps = push
    psf = push --force-with-lease
    r = !git log -30 --graph --pretty=format:'%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%Creset' --all --date=relative
    st = status -s
    v = "!f() { files=$(git status -s); [ -n \"$files\" ] && echo \"$files\" \
        | fzf --multi --header 'Pick files to open in nvim' \
        | cut -c4- | sed 's/.* -> //' \
        | xargs nvim || true ; }; f"
[core]
    editor = nvim
    autocrlf = input
[init]
    defaultBranch = master
[user]
    name = zerdaks
    email = 7451424+zerdaks@users.noreply.github.com
[url "https://github.com/"]
    insteadOf = git://github.com/
[pull]
    rebase = false
[push]
    autoSetupRemote = true
